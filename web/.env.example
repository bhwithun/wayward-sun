# Neon pooled connection string. Never commit the real value.
DATABASE_URL=

# Vercel env only. Never commit the key. Never put it in the Android app.
SOLCAST_API_KEY=

# Hobbyist rooftop resource. Default matches the Android app.
RESOURCE_ID=84d7-8b52-33f3-bd7b

# Same place the phone uses for Open-Meteo. History weather is fetched here.
SITE_LAT=
SITE_LNG=

# If set, GET /cron requires Authorization: Bearer <CRON_SECRET>.
# Vercel sends that header automatically when this env var exists.
# The same value is the OAuth state on /enphase/connect.
CRON_SECRET=

# Enphase Watt-plan app. Site level production monitoring must be enabled.
# Leave blank until the app exists. Never commit the real values. Never put them in the Android app.
ENPHASE_API_KEY=
ENPHASE_CLIENT_ID=
ENPHASE_CLIENT_SECRET=
# Optional. Discovered from the account when only one system is returned.
ENPHASE_SYSTEM_ID=
# Defaults to https://sun.brianandkathi.com/enphase/callback
ENPHASE_REDIRECT_URI=
# Optional folder with credentials.json and tokens.json. Used when the three vars above are empty.
# The harvest writes a rotated refresh token back to tokens.json in this folder.
ENPHASE_DIR=
