{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solcast-cache-worker",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "vars": {
    "RESOURCE_ID": "84d7-8b52-33f3-bd7b"
  },
  // Production KV. `wrangler dev` still uses a local simulation unless remote: true.
  "kv_namespaces": [
    { "binding": "CACHE", "id": "49b8cc376df140f78d811b2e70c29499" }
  ],
  "triggers": {
    // Empty array removes previously deployed cron triggers.
    "crons": []
  }
}
